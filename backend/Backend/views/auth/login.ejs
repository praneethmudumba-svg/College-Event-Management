<%- include('../partials/header') %>

<div class="form-card">
  <h2 style="text-align: center; margin-bottom: 0.5rem;">Sign In</h2>
  <p style="text-align: center; color: var(--text-muted); margin-bottom: 1.5rem;">Access your student account or administrative dashboard</p>

  <form action="/auth/login" method="POST">
    <div class="form-group">
      <label>Select Role</label>
      <select name="role" class="form-control">
        <option value="student" <%= role === 'student' ? 'selected' : '' %>>Student</option>
        <option value="admin" <%= role === 'admin' ? 'selected' : '' %>>Administrator</option>
      </select>
    </div>

    <div class="form-group">
      <label>Email Address</label>
      <input type="email" name="email" class="form-control" required placeholder="name@college.edu">
    </div>

    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" class="form-control" required placeholder="••••••••">
    </div>

    <button type="submit" class="btn btn-primary" style="width: 100%; justify-content: center; margin-top: 1rem;">Sign In</button>
  </form>

  <div style="margin-top: 1.5rem; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
    Demo credentials:<br>
    Admin: <code>admin@college.edu</code> / <code>admin123</code><br>
    Student: <code>student@college.edu</code> / <code>student123</code>
  </div>

  <div style="margin-top: 1.25rem; text-align: center; font-size: 0.85rem;">
    New student? <a href="/auth/register" style="color: var(--primary);">Create an account</a>
  </div>
</div>

<%- include('../partials/footer') %>
