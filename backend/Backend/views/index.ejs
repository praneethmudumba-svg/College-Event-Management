<%- include('partials/header') %>

<section class="hero">
  <h1>Make Campus Life Unforgettable</h1>
  <p>Discover exciting hackathons, cultural fests, workshops, and sports matches happening across the university campus.</p>
  <div style="display: flex; gap: 1rem; justify-content: center;">
    <a href="/events" class="btn btn-primary">Browse All Events →</a>
    <% if (!locals.currentStudent && !locals.currentAdmin) { %>
      <a href="/auth/login" class="btn btn-outline">Portal Sign In</a>
    <% } %>
  </div>
</section>

<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-num"><%= stats.totalEvents %></div>
    <div class="stat-label">Campus Events</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.totalStudents %></div>
    <div class="stat-label">Registered Students</div>
  </div>
  <div class="stat-card">
    <div class="stat-num"><%= stats.totalRegistrations %></div>
    <div class="stat-label">Event Registrations</div>
  </div>
</div>

<h2 style="margin-top: 3rem; margin-bottom: 1rem;">Featured Upcoming Events</h2>
<div class="events-grid">
  <% if (featuredEvents && featuredEvents.length > 0) { %>
    <% featuredEvents.forEach(event => { %>
      <div class="event-card">
        <img class="event-img" src="<%= event.banner_image || 'https://images.unsplash.com/photo-1511795409834-ef04bbd61622?auto=format&fit=crop&w=1200&q=80' %>" alt="<%= event.title %>">
        <div class="event-body">
          <span class="event-tag"><%= event.category %></span>
          <h3 class="event-title"><%= event.title %></h3>
          <p class="event-desc"><%= event.description.length > 100 ? event.description.substring(0, 100) + '...' : event.description %></p>
          <div class="event-meta">📅 <%= event.event_date %> at <%= event.event_time %></div>
          <div class="event-meta">📍 <%= event.venue_name || 'Main Campus' %></div>
          <div class="event-footer">
            <span style="font-size: 0.85rem; color: var(--text-muted);"><%= event.registered_count %> registered</span>
            <a href="/events/<%= event.id %>" class="btn btn-primary" style="padding: 0.4rem 0.85rem; font-size: 0.85rem;">View Event</a>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <p style="color: var(--text-muted);">No upcoming events at this moment.</p>
  <% } %>
</div>

<%- include('partials/footer') %>
