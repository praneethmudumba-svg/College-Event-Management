<%- include('../partials/header') %>

<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
  <div>
    <h2>Manage Campus Events</h2>
    <p style="color: var(--text-muted);">Create, update, view registrations and manage status</p>
  </div>
  <a href="/admin/events/new" class="btn btn-primary">+ Create New Event</a>
</div>

<div class="table-responsive">
  <table>
    <thead>
      <tr>
        <th>Event Title</th>
        <th>Category</th>
        <th>Date & Time</th>
        <th>Venue</th>
        <th>Registrations</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% if (events && events.length > 0) { %>
        <% events.forEach(event => { %>
          <tr>
            <td><strong><%= event.title %></strong></td>
            <td><span class="event-tag"><%= event.category %></span></td>
            <td><%= event.event_date %><br><small style="color: var(--text-muted);"><%= event.event_time %></small></td>
            <td><%= event.venue_name || 'Main Campus' %></td>
            <td>
              <strong><%= event.reg_count || 0 %></strong> / <%= event.max_participants %><br>
              <small style="color: #6ee7b7;"><%= event.attended_count || 0 %> attended</small>
            </td>
            <td>
              <span class="event-tag" style="background: <%= event.status === 'Upcoming' ? 'rgba(99, 102, 241, 0.2)' : 'rgba(148, 163, 184, 0.2)' %>; color: <%= event.status === 'Upcoming' ? '#a5b4fc' : '#94a3b8' %>;">
                <%= event.status %>
              </span>
            </td>
            <td>
              <div style="display: flex; gap: 0.5rem; align-items: center;">
                <a href="/admin/events/<%= event.id %>/participants" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;">Participants</a>
                <a href="/admin/events/<%= event.id %>/edit" class="btn btn-outline" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;">Edit</a>
                <form action="/admin/events/<%= event.id %>/delete" method="POST" style="display: inline;" onsubmit="return confirm('Are you sure you want to delete this event?');">
                  <button type="submit" class="btn btn-danger" style="padding: 0.35rem 0.65rem; font-size: 0.8rem;">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      <% } else { %>
        <tr>
          <td colspan="7" style="text-align: center; color: var(--text-muted); padding: 2rem;">No events found.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>

<%- include('../partials/footer') %>
